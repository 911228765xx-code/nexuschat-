# ─────────────────────────────────────────────────────────────
# 环境变量模板。复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）。
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── 必填 ──────────────────────────────────────────────────────
# MySQL 连接串，drizzle 迁移与运行时都用它
DATABASE_URL="mysql://user:password@localhost:3306/nexuschat"
# 登录/Cookie 签名密钥，务必改成随机长串
JWT_SECRET="change-me-to-a-long-random-string"

# ── 运行配置 ──────────────────────────────────────────────────
NODE_ENV="development"          # development | production
PORT="3000"                     # 端口被占用会自动顺延
LOG_LEVEL="info"                # pino 日志级别
TRUST_PROXY_HOPS="1"            # 前置反向代理/CDN 层数（取真实客户端 IP 用）
PUBLIC_ORIGIN="https://nexuschat.best"
# 后台 Android 下载地址误配/为空时使用的真实 APK 文件源（不能填本站 /apk 或 /download）
ANDROID_APK_FALLBACK_URL=""
# 额外允许的跨域来源，逗号分隔（原生 App + 已配置域名之外）
ALLOWED_ORIGINS=""

# ── OAuth / 身份 ──────────────────────────────────────────────
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""                # 管理员 openId（admin 页面权限）
VITE_APP_ID=""

# ── 内置 LLM 网关（AI 助手 / 投研）────────────────────────────
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ── 邮件 / 验证码 ─────────────────────────────────────────────
RESEND_API_KEY=""               # Resend 发信
TURNSTILE_SECRET_KEY=""         # Cloudflare Turnstile 人机校验

# ── Web Push（站内推送）──────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL=""

# ── 链上数据 / 行情 ───────────────────────────────────────────
ALCHEMY_API_KEY=""
ETHERSCAN_API_KEY=""
BSCSCAN_API_KEY=""

# ── 前端钱包 ──────────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=""

# 节点认购 USDT 收款地址（链上，App 外结算）
USDT_DEPOSIT_ADDRESS=
USDT_CHAIN=TRC20
